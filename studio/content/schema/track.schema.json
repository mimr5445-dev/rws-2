{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "targetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "property": {
      "type": "string",
      "enum": [
        "position",
        "scale",
        "opacity",
        "rotation"
      ]
    },
    "keyframes": {
      "minItems": 2,
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "object",
                "properties": {
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                },
                "required": [
                  "lon",
                  "lat"
                ],
                "additionalProperties": false
              }
            ]
          },
          "easing": {
            "type": "string",
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut",
              "step"
            ]
          }
        },
        "required": [
          "tick",
          "value",
          "easing"
        ],
        "additionalProperties": false
      }
    },
    "path": {
      "type": "object",
      "properties": {
        "points": {
          "minItems": 2,
          "maxItems": 512,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "required": [
              "lon",
              "lat"
            ],
            "additionalProperties": false
          }
        },
        "startTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "endTick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "easing": {
          "type": "string",
          "enum": [
            "linear",
            "easeIn",
            "easeOut",
            "easeInOut",
            "step"
          ]
        }
      },
      "required": [
        "points",
        "startTick",
        "endTick",
        "easing"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "targetId",
    "property"
  ],
  "additionalProperties": false
}
