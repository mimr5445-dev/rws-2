{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "flash",
        "fireball",
        "shockwave",
        "shards",
        "smoke",
        "ember",
        "crater",
        "pulse",
        "shake"
      ]
    },
    "at": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tick"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+\\.(arrived|done)$"
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        }
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "lon",
        "lat"
      ],
      "additionalProperties": false
    },
    "intensity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "soundClipId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "id",
    "kind",
    "at",
    "position",
    "intensity"
  ],
  "additionalProperties": false
}
