{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "locale": {
      "type": "string",
      "enum": [
        "ar",
        "en"
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "map": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "durationTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 216000
    },
    "entities": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "unit",
              "marker",
              "structure",
              "zone",
              "label"
            ]
          },
          "assetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "side": {
            "type": "string",
            "enum": [
              "a",
              "b",
              "neutral"
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "required": [
              "lon",
              "lat"
            ],
            "additionalProperties": false
          },
          "scale": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10
          },
          "spawnTick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "despawnTick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "kind",
          "assetId",
          "side",
          "position",
          "scale"
        ],
        "additionalProperties": false
      }
    },
    "tracks": {
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "property": {
            "type": "string",
            "enum": [
              "position",
              "scale",
              "opacity",
              "rotation"
            ]
          },
          "keyframes": {
            "minItems": 2,
            "maxItems": 4096,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "tick": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "anyOf": [
                    {
                      "type": "number"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "lon": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        "lat": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        }
                      },
                      "required": [
                        "lon",
                        "lat"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "easing": {
                  "type": "string",
                  "enum": [
                    "linear",
                    "easeIn",
                    "easeOut",
                    "easeInOut",
                    "step"
                  ]
                }
              },
              "required": [
                "tick",
                "value",
                "easing"
              ],
              "additionalProperties": false
            }
          },
          "path": {
            "type": "object",
            "properties": {
              "points": {
                "minItems": 2,
                "maxItems": 512,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "lon": {
                      "type": "number",
                      "minimum": -180,
                      "maximum": 180
                    },
                    "lat": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    }
                  },
                  "required": [
                    "lon",
                    "lat"
                  ],
                  "additionalProperties": false
                }
              },
              "startTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "endTick": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "easing": {
                "type": "string",
                "enum": [
                  "linear",
                  "easeIn",
                  "easeOut",
                  "easeInOut",
                  "step"
                ]
              }
            },
            "required": [
              "points",
              "startTick",
              "endTick",
              "easing"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "targetId",
          "property"
        ],
        "additionalProperties": false
      }
    },
    "triggers": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "when": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tick": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tick"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "after": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+\\.(arrived|done)$"
                  }
                },
                "required": [
                  "after"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "id",
          "when"
        ],
        "additionalProperties": false
      }
    },
    "effects": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "flash",
              "fireball",
              "shockwave",
              "shards",
              "smoke",
              "ember",
              "crater",
              "pulse",
              "shake"
            ]
          },
          "at": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tick": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tick"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "after": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+\\.(arrived|done)$"
                  }
                },
                "required": [
                  "after"
                ],
                "additionalProperties": false
              }
            ]
          },
          "position": {
            "type": "object",
            "properties": {
              "lon": {
                "type": "number",
                "minimum": -180,
                "maximum": 180
              },
              "lat": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              }
            },
            "required": [
              "lon",
              "lat"
            ],
            "additionalProperties": false
          },
          "intensity": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "soundClipId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "id",
          "kind",
          "at",
          "position",
          "intensity"
        ],
        "additionalProperties": false
      }
    },
    "cues": {
      "maxItems": 2000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
          },
          "when": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "tick": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                },
                "required": [
                  "tick"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "after": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.:-]+\\.(arrived|done)$"
                  }
                },
                "required": [
                  "after"
                ],
                "additionalProperties": false
              }
            ]
          },
          "clipId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "gain": {
            "type": "number",
            "minimum": 0,
            "maximum": 4
          },
          "pan": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "required": [
          "id",
          "when",
          "clipId",
          "gain",
          "pan"
        ],
        "additionalProperties": false
      }
    },
    "camera": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "lon": {
            "type": "number",
            "minimum": -180,
            "maximum": 180
          },
          "lat": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          },
          "zoom": {
            "type": "number",
            "minimum": 0.25,
            "maximum": 4
          },
          "easing": {
            "type": "string",
            "enum": [
              "linear",
              "easeIn",
              "easeOut",
              "easeInOut",
              "step"
            ]
          }
        },
        "required": [
          "tick",
          "lon",
          "lat",
          "zoom",
          "easing"
        ],
        "additionalProperties": false
      }
    },
    "variables": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "title",
    "locale",
    "seed",
    "map",
    "durationTicks",
    "entities",
    "tracks",
    "triggers",
    "effects",
    "cues",
    "camera",
    "variables"
  ],
  "additionalProperties": false
}
