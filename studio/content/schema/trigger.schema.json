{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "when": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "tick"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.:-]+\\.(arrived|done)$"
            }
          },
          "required": [
            "after"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "when"
  ],
  "additionalProperties": false
}
