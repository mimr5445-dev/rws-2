{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "lon": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "lat": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "zoom": {
      "type": "number",
      "minimum": 0.25,
      "maximum": 4
    },
    "easing": {
      "type": "string",
      "enum": [
        "linear",
        "easeIn",
        "easeOut",
        "easeInOut",
        "step"
      ]
    }
  },
  "required": [
    "tick",
    "lon",
    "lat",
    "zoom",
    "easing"
  ],
  "additionalProperties": false
}
