{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "unit",
        "marker",
        "structure",
        "zone",
        "label"
      ]
    },
    "assetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "side": {
      "type": "string",
      "enum": [
        "a",
        "b",
        "neutral"
      ]
    },
    "position": {
      "type": "object",
      "properties": {
        "lon": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "lat": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      },
      "required": [
        "lon",
        "lat"
      ],
      "additionalProperties": false
    },
    "scale": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 10
    },
    "spawnTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "despawnTick": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "id",
    "kind",
    "assetId",
    "side",
    "position",
    "scale"
  ],
  "additionalProperties": false
}
